# OpenMi Backend Environment Variables
# -------------------------------------------------------------
PORT=3001
DB_PATH=openmi.sqlite

# Security
MASTER_PASSWORD=admin
JWT_SECRET=openmi-default-secret-change-me

# CORS Configuration
# Set to * (or leave blank) to allow any frontend domain (mirrors client origin with credentials)
# Or specify allowed origins separated by commas:
# CORS_ORIGIN=https://openmi.vercel.app,http://localhost:3000
CORS_ORIGIN=*
