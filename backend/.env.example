# OpenMi Backend Environment Configuration

# Port the backend server listens on
PORT=3001

# Master Password required to unlock the web dashboard
MASTER_PASSWORD=change_this_to_a_strong_password

# Secret key used to sign JWT session tokens
JWT_SECRET=generate_a_random_long_secret_key_here

# Path to the SQLite database file
DB_PATH=openmi.sqlite

# Environment mode
NODE_ENV=production
