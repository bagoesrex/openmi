# OpenMi Frontend Environment Variables
# -------------------------------------------------------------
# In local development:
# Leave empty or omit to use Vite's dev proxy (which routes /api to http://localhost:3001)
#
# In production (e.g., Vercel):
# Set this to your VPS backend API URL (without trailing slash)
# Example: https://api.yourdomain.com or http://123.45.67.89:3001
VITE_API_BASE_URL=
